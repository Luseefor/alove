  "methodology": {
    "payload": "Synthetic ASCII source map segmented at max 1 MiB per file with main.tex first (same segmentation as the existing browser harness). File contents are 'x' repeats so UTF-8 bytes equal character count. Payloads are cloned per record via object spread with identical content.",
    "pairing": "5 paired rounds per size (1 MiB, 10 MiB). Within each round both variants run 5 sequential save/list steps against an isolated fresh IndexedDB database; round order alternates baseline-first vs updated-first to control order effects.",
    "retention": "Default repository retention applies (max 20 records / 50 MiB per project, newest plus newest-ok pinned); with 5 records per database no eviction is expected, but the growing-history retention scan runs inside every save after the first.",
    "timingBoundary": "Each saveMs covers performance.now() immediately before/after await repository.save(record) only. Each listMs covers performance.now() immediately before/after await repository.list(projectId) only. Records are built with the actual createBuildRecord helper BEFORE the save timer (hashing excluded). firstSaveMs is index 0 of each round (includes IndexedDB creation); laterSaveMs is indices 1-4 (includes growing history plus retention scan). Per size/variant: n=5 first saves, n=20 later saves, n=25 lists; all raw samples retained.",
    "isolation": "One fresh IndexedDB database per variant per round; only databases created by this script are deleted, with deleteDatabase awaited to onsuccess before proceeding.",
    "scope": "IndexedDB storage comparison only. Not an API latency, TeX compilation, typing, INP, paint, or burst-typing measurement. No server load is applied.",
    "timeouts": {
      "gitMs": 15000,
      "navMs": 30000,
      "variantEvaluateMs": 180000,
      "overallMs": 900000
    }
  },
