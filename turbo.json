{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "REDIS_*",
        "COMPILE_*",
        "ALOVE_*",
        "CLERK_*",
        "NEXT_PUBLIC_*",
        "WORKER_*",
        "DOCKER_*"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [],
      "outputs": []
    },
    "@alove/editor#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    }
  }
}
