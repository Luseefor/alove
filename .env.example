# --- Web/Local mode ---
# Local standalone mode can run without Clerk/Convex
NEXT_PUBLIC_LOCAL_STANDALONE=true
# Server-only anonymous compute. Bind Next to 127.0.0.1 and use this exact origin.
# The local dev launcher sets this to its chosen port automatically.
ALOVE_LOCAL_COMPILE_ORIGIN=http://127.0.0.1:30127
NEXT_PUBLIC_EDITOR_MODE=codemirror

# --- Cloud/Production mode (Clerk & Convex) ---
# Production/cloud mode must have Clerk/Convex configured
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CONVEX_URL=
CLERK_WEBHOOK_SECRET=
CONVEX_DEPLOY_KEY=
CLERK_JWT_ISSUER_DOMAIN=

# --- Queue ---
# Redis must be shared by web API and compile worker
# Production requires authenticated TLS. URL takes precedence when explicit host/port are unset.
REDIS_URL=
REDIS_TLS_CA=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Compile worker ---
# Set the number of concurrent compile jobs
WORKER_CONCURRENCY=1
# Docker access is required if COMPILE_USE_DOCKER=true
COMPILE_WORK_ROOT=.
# Build the pinned local image using services/tex-runner/Dockerfile.local.
COMPILE_USE_DOCKER=true
COMPILE_WORK_ROOT=
COMPILE_DOCKER_IMAGE=alove-tex:local
COMPILE_DOCKER_PLATFORM=
COMPILE_TIMEOUT_MS=60000
COMPILE_MAX_FILES=250
COMPILE_MAX_FILE_BYTES=1048576
COMPILE_MAX_TOTAL_BYTES=10485760
COMPILE_MAX_LOG_BYTES=262144
COMPILE_MAX_PDF_BYTES=52428800
