{
  "name": "alove",
  "private": true,
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "convex:dev": "bun run --filter web convex:dev",
    "dev:with-convex": "bun run --filter web dev:with-convex",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "docker:dev:detached": "docker compose -f docker-compose.dev.yml up --build -d",
    "docker:down": "docker compose -f docker-compose.dev.yml down",
    "docker:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "docker:ps": "docker compose -f docker-compose.dev.yml ps",
    "docker:health": "curl -fsS http://localhost:3000/api/health",
    "smoke:docker": "bash scripts/smoke-docker-stack.sh",
    "bench:recovery": "bun scripts/benchmarks/runRecoveryBenchmark.ts",
    "bench:browser": "bun scripts/benchmarks/browserBenchmark.ts",
    "test:benchmarks": "bun test ./scripts/benchmarks/*.test.ts",
    "bench:report": "python3 scripts/benchmarks/reportBenchmark.py",
    "bench:resources": "bun scripts/benchmarks/profileTexResources.ts"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "turbo": "^2.9.6",
    "typescript": "^5.9.3"
  }
}
