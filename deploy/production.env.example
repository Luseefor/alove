# Keep real values in the GitHub production environment, never commit them.
# Variables
ALOVE_SITE_URL=
NEXT_PUBLIC_LOCAL_STANDALONE=false
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CONVEX_URL=
CLERK_JWT_ISSUER_DOMAIN=
DEPLOY_WEB_HOST=
DEPLOY_RUNNER_HOST=
DEPLOY_SSH_USER=alove
# Secrets
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
CONVEX_DEPLOY_KEY=
REDIS_URL=
DEPLOY_SSH_PRIVATE_KEY=
DEPLOY_SSH_KNOWN_HOSTS=
# Runner settings (workflow supplies these; TeX image is built and pinned per release)
COMPILE_USE_DOCKER=true
COMPILE_WORK_ROOT=/var/lib/alove/jobs
WORKER_CONCURRENCY=1
# Never enable these in cloud deployments
ALOVE_LOCAL_COMPILE_ORIGIN=
COMPILE_TRUSTED_LOCAL=false
