# --- Queue ---
# Redis must be shared by web API and compile worker
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Compile worker ---
# Set the number of concurrent compile jobs
WORKER_CONCURRENCY=1
# Docker access is required if COMPILE_WORK_ROOT=
COMPILE_USE_DOCKER=true
# Host TeX is a trusted local option only; forbidden when NODE_ENV=production.
COMPILE_TRUSTED_LOCAL=false
# Build services/tex-runner/Dockerfile.local for this local image.
COMPILE_USE_DOCKER=true
COMPILE_DOCKER_IMAGE=alove-tex:local
COMPILE_DOCKER_PLATFORM=
COMPILE_TIMEOUT_MS=60000
COMPILE_MAX_FILES=250
COMPILE_MAX_FILE_BYTES=1048576
COMPILE_MAX_TOTAL_BYTES=10485760
COMPILE_MAX_LOG_BYTES=262144
COMPILE_MAX_PDF_BYTES=52428800

# Server-only sandbox caps. Invalid/out-of-range values fail closed.
COMPILE_SANDBOX_MEMORY_MB=1024
COMPILE_SANDBOX_CPUS=1
COMPILE_SANDBOX_PIDS=64
COMPILE_SANDBOX_WORK_MB=128
COMPILE_SANDBOX_TMP_MB=128
